<Window x:Class="健康助手.Windows.ReminderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑提醒"
        Width="520" Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource PixelFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="EditTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="Background" Value="{StaticResource CardFill}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="2,10,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Border Margin="4,4,0,0" Background="{StaticResource BorderDark}"/>
        <Border Background="{StaticResource PaperTexture}"
                BorderBrush="{StaticResource BorderDark}" BorderThickness="3"
                Margin="0,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{StaticResource PanelFill}">
                    <TextBlock x:Name="TitleText" Text="编辑提醒" FontSize="18"
                               Foreground="{StaticResource InkBrush}" Margin="14,0"
                               VerticalAlignment="Center"/>
                    <Button Content="×" Click="Cancel_Click" Width="32" Height="32"
                            FontSize="16" Style="{StaticResource PixelButtonStyle}"
                            HorizontalAlignment="Right" Margin="0,0,10,0"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,10">
                    <StackPanel>
                        <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource EditTextBox}"/>

                        <TextBlock Text="提醒内容" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MessageBox" Style="{StaticResource EditTextBox}"
                                 Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"/>

                        <TextBlock Text="间隔（分钟，1–1440）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="IntervalBox" Style="{StaticResource EditTextBox}" Width="140"
                                 HorizontalAlignment="Left"/>

                        <TextBlock Text="按钮文字（例如：立即开始 / 我喝完了）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ActionBox" Style="{StaticResource EditTextBox}"/>

                        <TextBlock Text="点击按钮后的倒计时秒数（0 表示无倒计时，1–600）"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CountdownBox" Style="{StaticResource EditTextBox}" Width="140"
                                 HorizontalAlignment="Left"/>

                        <CheckBox x:Name="EnabledCheck" Content="启用此提醒" Margin="2,14,0,0"
                                  Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>

                        <TextBlock x:Name="ErrorText" Text="" FontSize="13"
                                   Foreground="{StaticResource AccentDarkBrush}"
                                   TextWrapping="Wrap" Margin="2,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="18,4,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="* 必填" FontSize="12"
                               Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="取消" Click="Cancel_Click" Width="110"
                                Style="{StaticResource PixelButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="保存" Click="Save_Click" Width="110"
                                Style="{StaticResource PixelButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
