<Window x:Class="健康助手.Windows.PomodoroSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="番茄钟设置"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource PixelFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="EditTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="Background" Value="{StaticResource CardFill}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="2,10,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Border Margin="4,4,0,0" Background="{StaticResource BorderDark}"/>
        <Border Background="{StaticResource PaperTexture}"
                BorderBrush="{StaticResource BorderDark}" BorderThickness="3"
                Margin="0,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{StaticResource PanelFill}">
                    <TextBlock Text="番茄钟设置" FontSize="18"
                               Foreground="{StaticResource InkBrush}" Margin="14,0"
                               VerticalAlignment="Center"/>
                    <Button Content="×" Click="Cancel_Click" Width="32" Height="32"
                            FontSize="16" Style="{StaticResource PixelButtonStyle}"
                            HorizontalAlignment="Right" Margin="0,0,10,0"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,8">
                    <StackPanel>
                        <TextBlock Text="专注时长（分钟，1–120）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WorkBox" Style="{StaticResource EditTextBox}" Width="140"
                                 HorizontalAlignment="Left"/>

                        <TextBlock Text="短休息（分钟，1–30）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ShortBox" Style="{StaticResource EditTextBox}" Width="140"
                                 HorizontalAlignment="Left"/>

                        <TextBlock Text="长休息（分钟，1–60）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="LongBox" Style="{StaticResource EditTextBox}" Width="140"
                                 HorizontalAlignment="Left"/>

                        <TextBlock Text="每几个番茄长休一次（1–12）" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CyclesBox" Style="{StaticResource EditTextBox}" Width="140"
                                 HorizontalAlignment="Left"/>

                        <TextBlock Text="改动保存后立即生效，仅影响之后开始的阶段"
                                   FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                                   Margin="2,12,0,0"/>
                        <TextBlock x:Name="ErrorText" Text="" FontSize="13"
                                   Foreground="{StaticResource AccentDarkBrush}"
                                   TextWrapping="Wrap" Margin="2,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="18,4,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Click="Cancel_Click" Width="110"
                                Style="{StaticResource PixelButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="保存" Click="Save_Click" Width="110"
                                Style="{StaticResource PixelButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
