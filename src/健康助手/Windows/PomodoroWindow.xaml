<Window x:Class="健康助手.Windows.PomodoroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="番茄钟"
        Width="500" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource PixelFont}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Border Margin="4,4,0,0" Background="{StaticResource BorderDark}"/>
        <Border Background="{StaticResource PaperTexture}"
                BorderBrush="{StaticResource BorderDark}" BorderThickness="3"
                Margin="0,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{StaticResource PanelFill}"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="番茄钟" FontSize="18" Foreground="{StaticResource InkBrush}"
                               Margin="14,0" VerticalAlignment="Center"/>
                    <Button Content="×" Click="CloseButton_Click" Width="32" Height="32"
                            FontSize="16" Style="{StaticResource PixelButtonStyle}"
                            HorizontalAlignment="Right" Margin="0,0,10,0" ToolTip="隐藏到后台继续计时"/>
                </Grid>
                <Grid Grid.Row="1" Margin="18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PhaseText" Text="准备开始" FontSize="17"
                               Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="RemainingText" Text="25:00" FontSize="76"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <UniformGrid x:Name="ProgressGrid" Grid.Row="2" Rows="1" Columns="20"
                                 Height="14" Margin="4,0,4,14"/>
                    <TextBlock x:Name="StatusText" Grid.Row="3" Text="空闲，点击「开始」进入专注"
                               FontSize="13" Foreground="{StaticResource InkMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="StartPauseButton" Content="开始" Click="StartPause_Click"
                                MinWidth="110" Height="38" FontSize="15"
                                Style="{StaticResource PixelButtonStyle}" Margin="0,0,6,0"/>
                        <Button x:Name="SkipButton" Content="跳过" Click="Skip_Click"
                                MinWidth="80" Height="38" FontSize="15"
                                Style="{StaticResource PixelButtonStyle}" Margin="0,0,6,0"/>
                        <Button x:Name="StopButton" Content="停止" Click="Stop_Click"
                                MinWidth="80" Height="38" FontSize="15"
                                Style="{StaticResource PixelButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="设置" Click="Settings_Click"
                                MinWidth="80" Height="38" FontSize="15"
                                Style="{StaticResource PixelButtonStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Text="关闭窗口后仍在后台计时，阶段结束会弹出提醒"
                               FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
