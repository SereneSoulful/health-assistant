<Application x:Class="健康助手.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PaperBackdrop" Color="#F2E6CD"/>
        <SolidColorBrush x:Key="PaperTextureA" Color="#EFE2C6"/>
        <SolidColorBrush x:Key="PanelFill" Color="#E3D3B2"/>
        <SolidColorBrush x:Key="CardFill" Color="#FFF7E8"/>
        <SolidColorBrush x:Key="BorderDark" Color="#4A3827"/>
        <SolidColorBrush x:Key="BorderLight" Color="#FFF9EC"/>
        <SolidColorBrush x:Key="InkBrush" Color="#3B2E23"/>
        <SolidColorBrush x:Key="InkMutedBrush" Color="#8A7A63"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D94F30"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#7A2E1C"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#F27A52"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#E8A33D"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#6FA86B"/>
        <SolidColorBrush x:Key="DeepGreenBrush" Color="#166534"/>

        <FontFamily x:Key="PixelFont">pack://application:,,,/Fonts/FusionPixel12.ttf#Fusion Pixel 12px Prop zh_hans</FontFamily>

        <DrawingBrush x:Key="PaperTexture" TileMode="Tile"
                      Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource PaperBackdrop}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,8"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource PaperTextureA}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,2,2"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource PaperTextureA}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="4,4,2,2"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="PixelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="shadow" Margin="3,3,0,0"
                                    Background="{StaticResource BorderDark}"/>
                            <Border x:Name="bd"
                                    Background="{StaticResource CardFill}"
                                    BorderBrush="{StaticResource BorderDark}"
                                    BorderThickness="2">
                                <Grid>
                                    <Border BorderBrush="{StaticResource BorderLight}"
                                            BorderThickness="1" Margin="2"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="2" Y="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
