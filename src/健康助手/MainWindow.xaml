<Window x:Class="健康助手.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="健康助手"
        Width="760" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource PixelFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="PixelTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="Background" Value="{StaticResource CardFill}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="PixelCheck" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Border Margin="4,4,0,0" Background="{StaticResource BorderDark}"/>
        <Border Background="{StaticResource PaperTexture}"
                BorderBrush="{StaticResource BorderDark}" BorderThickness="3"
                Margin="0,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{StaticResource PanelFill}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="健康助手" FontSize="20" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="规律休息，健康用电脑" FontSize="13" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Bottom" Margin="12,0,0,3"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button Content="─" Click="Minimize_Click" Width="32" Height="32" FontSize="16"
                                Style="{StaticResource PixelButtonStyle}" Margin="0,0,4,0" ToolTip="最小化"/>
                        <Button Content="×" Click="Close_Click" Width="32" Height="32" FontSize="16"
                                Style="{StaticResource PixelButtonStyle}" ToolTip="隐藏到托盘"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2,4,10">
                        <Button Content="＋ 添加提醒" Click="Add_Click" Style="{StaticResource PixelButtonStyle}"
                                MinWidth="140" FontSize="15"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                        <ItemsControl x:Name="ReminderList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardFill}"
                                            BorderBrush="{StaticResource BorderDark}" BorderThickness="2"
                                            Margin="2,2,2,10" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                                                    <TextBlock Text="{Binding IntervalText}" FontSize="13" Foreground="{StaticResource InkMutedBrush}" Margin="12,0,0,0" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsEnabled}" Checked="Toggle_Changed"
                                                              Unchecked="Toggle_Changed" Content="启用"
                                                              Style="{StaticResource PixelCheck}" Margin="0,0,12,0"/>
                                                    <Button Content="测试" Click="CardButton_Click" Tag="Test"
                                                            Style="{StaticResource CardButton}" Margin="0,0,6,0"/>
                                                    <Button Content="编辑" Click="CardButton_Click" Tag="Edit"
                                                            Style="{StaticResource CardButton}" Margin="0,0,6,0"/>
                                                    <Button Content="删除" Click="CardButton_Click" Tag="Delete"
                                                            Style="{StaticResource CardButton}"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Message}" FontSize="15"
                                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding CountdownText}" FontSize="13"
                                                           Foreground="{StaticResource InkMutedBrush}"/>
                                                <TextBlock Text=" · " FontSize="13"
                                                           Foreground="{StaticResource InkMutedBrush}"/>
                                                <TextBlock Text="{Binding NextText}" FontSize="13"
                                                           Foreground="{StaticResource InkMutedBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{StaticResource PanelFill}"
                            BorderBrush="{StaticResource BorderDark}" BorderThickness="2"
                            Padding="12,8" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="StartupCheck" Content="开机自启"
                                      Checked="Startup_Changed" Unchecked="Startup_Changed"
                                      Style="{StaticResource PixelCheck}" Margin="0,0,22,0"/>
                            <CheckBox x:Name="SoundCheck" Content="提醒音"
                                      Checked="Sound_Changed" Unchecked="Sound_Changed"
                                      Style="{StaticResource PixelCheck}" Margin="0,0,22,0"/>
                            <TextBlock Text="关闭窗口后最小化到托盘，提醒不会中断" FontSize="12"
                                       Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
